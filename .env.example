NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# Generate a dev keypair with `npm run keys:generate` and paste the PUBLIC
# key here. dotenv supports multi-line values wrapped in double quotes.
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nPASTE_YOUR_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_ISSUER=gatewayx-auth

REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gatewayx

ROUTES_CONFIG_PATH=src/config/routes.yaml
READINESS_REFRESH_INTERVAL_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

CORS_ORIGINS=*

# Pepper for HMAC-SHA256 API key hashing (Tier 2). Not a secret you rotate
# often, but must never be committed.
API_KEY_PEPPER=change-me-in-production
